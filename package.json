{
  "name": "obsidian-notes-and-snippets",
  "displayName": "Obsidian Artifacts: AI Snippets & Tools",
  "description": "Extension that allows you access to your vault's notes and use them in your code or create new ones",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.117.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "obsidian-artifacts.settings",
        "title": "Obsidian Artifacts: Settings"
      },
      {
        "command": "obsidian-artifacts.insert.snippets",
        "category": "Obsidian Artifacts",
        "title": "Insert Snippets"
      },
      {
        "command": "obsidian-artifacts.insert.aiagentsconf",
        "category": "Obsidian Artifacts",
        "title": "Insert AI Agent Config"
      },
      {
        "command": "obsidian-artifacts.insert.commands",
        "category": "Obsidian Artifacts",
        "title": "Insert Command"
      },
      {
        "command": "obsidian-artifacts.insert.templates",
        "category": "Obsidian Artifacts",
        "title": "Insert Template"
      },
      {
        "command": "obsidian-artifacts.insert.aiprompts",
        "category": "Obsidian Artifacts",
        "title": "Insert AI Prompt"
      },
      {
        "command": "obsidian-artifacts.insert.aiprompts.terminal",
        "category": "Obsidian Artifacts",
        "title": "Insert AI Prompt"
      },
      {
        "command": "obsidian-artifacts.insert.variables",
        "category": "Obsidian Artifacts",
        "title": "See/Edit Variables"
      },
      {
        "command": "obsidian-artifacts.migrateFrontmatter",
        "title": "Obsidian Artifacts: Migrate Vault Frontmatter"
      },
      {
        "command": "obsidian-artifacts.create.snippets",
        "title": "Obsidian Artifacts: Create Snippet from Selection"
      },
      {
        "command": "obsidian-artifacts.create.aiagentsconf",
        "title": "Obsidian Artifacts: Create AI Agents Config from File"
      },
      {
        "command": "obsidian-artifacts.create.commands",
        "title": "Obsidian Artifacts: Create Command from Terminal"
      },
      {
        "command": "obsidian-artifacts.create.templates",
        "title": "Obsidian Artifacts: Create Template from File"
      },
      {
        "command": "obsidian-artifacts.create.aiprompts",
        "title": "Obsidian Artifacts: Create AI Prompt from Selection"
      },
      {
        "command": "obsidian-artifacts.create.aiprompts.terminal",
        "title": "Obsidian Artifacts: Create AI Prompt from Terminal"
      },
      {
        "command": "obsidian-artifacts.create.aiagentsconf.index",
        "title": "Obsidian Artifacts: Create AI Agents Config Index from Selection"
      },
      {
        "command": "obsidian-artifacts.create.templates.index",
        "title": "Obsidian Artifacts: Create Template Index from Selection"
      },
      {
        "command": "obsidian-artifacts.variables.newFile",
        "title": "New Variables File",
        "category": "Obsidian Artifacts",
        "icon": "$(new-file)"
      },
      {
        "command": "obsidian-artifacts.variables.newSubSet",
        "title": "New Sub-Set",
        "category": "Obsidian Artifacts",
        "icon": "$(add)"
      },
      {
        "command": "obsidian-artifacts.variables.addVar",
        "title": "Add Variable",
        "category": "Obsidian Artifacts",
        "icon": "$(add)"
      },
      {
        "command": "obsidian-artifacts.variables.editValue",
        "title": "Edit Value",
        "category": "Obsidian Artifacts",
        "icon": "$(edit)"
      },
      {
        "command": "obsidian-artifacts.variables.renameVar",
        "title": "Rename Variable",
        "category": "Obsidian Artifacts",
        "icon": "$(edit)"
      },
      {
        "command": "obsidian-artifacts.variables.deleteVar",
        "title": "Delete Variable",
        "category": "Obsidian Artifacts",
        "icon": "$(trash)"
      },
      {
        "command": "obsidian-artifacts.variables.deleteSubSet",
        "title": "Delete Sub-Set",
        "category": "Obsidian Artifacts",
        "icon": "$(trash)"
      },
      {
        "command": "obsidian-artifacts.variables.deleteFile",
        "title": "Delete Variables File",
        "category": "Obsidian Artifacts",
        "icon": "$(trash)"
      },
      {
        "command": "obsidian-artifacts.variables.renameSubSet",
        "title": "Rename Sub-Set",
        "category": "Obsidian Artifacts",
        "icon": "$(edit)"
      }
    ],
    "submenus": [
      {
        "id": "obsidian-artifacts.submenu.editor",
        "label": "Obsidian Artifacts"
      },
      {
        "id": "obsidian-artifacts.submenu.terminal",
        "label": "Obsidian Artifacts"
      },
      {
        "id": "obsidian-artifacts.submenu.explorer",
        "label": "Obsidian Artifacts"
      },
      {
        "id": "obsidian-artifacts.submenu.create.editor",
        "label": "Obsidian Artifacts: Create"
      },
      {
        "id": "obsidian-artifacts.submenu.create.terminal",
        "label": "Obsidian Artifacts: Create"
      },
      {
        "id": "obsidian-artifacts.submenu.create.explorer",
        "label": "Obsidian Artifacts: Create"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "obsidian-artifacts.insert.aiprompts.terminal",
          "when": "false"
        },
        {
          "command": "obsidian-artifacts.create.aiprompts.terminal",
          "when": "false"
        },
        {
          "command": "obsidian-artifacts.create.aiagentsconf.index",
          "when": "false"
        },
        {
          "command": "obsidian-artifacts.create.templates.index",
          "when": "false"
        },
        {
          "command": "obsidian-artifacts.variables.newFile",
          "when": "false"
        },
        {
          "command": "obsidian-artifacts.variables.newSubSet",
          "when": "false"
        },
        {
          "command": "obsidian-artifacts.variables.addVar",
          "when": "false"
        },
        {
          "command": "obsidian-artifacts.variables.editValue",
          "when": "false"
        },
        {
          "command": "obsidian-artifacts.variables.renameVar",
          "when": "false"
        },
        {
          "command": "obsidian-artifacts.variables.deleteVar",
          "when": "false"
        },
        {
          "command": "obsidian-artifacts.variables.deleteSubSet",
          "when": "false"
        },
        {
          "command": "obsidian-artifacts.variables.deleteFile",
          "when": "false"
        },
        {
          "command": "obsidian-artifacts.variables.renameSubSet",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "obsidian-artifacts.insert.snippets",
          "when": "obsidian-artifacts.vaultConfigured && obsidian-artifacts.snippetsActive && !obsidian-artifacts.editorHasMultiple",
          "group": "obsidian@1"
        },
        {
          "command": "obsidian-artifacts.insert.aiprompts",
          "when": "obsidian-artifacts.vaultConfigured && obsidian-artifacts.aipromptsActive && !obsidian-artifacts.editorHasMultiple",
          "group": "obsidian@1"
        },
        {
          "command": "obsidian-artifacts.insert.variables",
          "when": "obsidian-artifacts.vaultConfigured && obsidian-artifacts.variablesActive && !obsidian-artifacts.editorHasMultiple",
          "group": "obsidian@1"
        },
        {
          "submenu": "obsidian-artifacts.submenu.editor",
          "when": "obsidian-artifacts.vaultConfigured && obsidian-artifacts.editorHasMultiple",
          "group": "obsidian@1"
        },
        {
          "command": "obsidian-artifacts.create.snippets",
          "when": "editorHasSelection && obsidian-artifacts.vaultConfigured && obsidian-artifacts.snippetsActive && !obsidian-artifacts.editorCreateHasMultiple",
          "group": "3_create@1"
        },
        {
          "command": "obsidian-artifacts.create.aiprompts",
          "when": "editorHasSelection && obsidian-artifacts.vaultConfigured && obsidian-artifacts.aipromptsActive && !obsidian-artifacts.editorCreateHasMultiple",
          "group": "3_create@2"
        },
        {
          "submenu": "obsidian-artifacts.submenu.create.editor",
          "when": "editorHasSelection && obsidian-artifacts.vaultConfigured && obsidian-artifacts.editorCreateHasMultiple",
          "group": "3_create@1"
        }
      ],
      "terminal/context": [
        {
          "command": "obsidian-artifacts.insert.commands",
          "when": "obsidian-artifacts.vaultConfigured && obsidian-artifacts.commandsActive && !obsidian-artifacts.terminalHasMultiple",
          "group": "obsidian@1"
        },
        {
          "command": "obsidian-artifacts.insert.aiprompts.terminal",
          "when": "obsidian-artifacts.vaultConfigured && obsidian-artifacts.aipromptsActive && !obsidian-artifacts.terminalHasMultiple",
          "group": "obsidian@1"
        },
        {
          "command": "obsidian-artifacts.insert.variables",
          "when": "obsidian-artifacts.vaultConfigured && obsidian-artifacts.variablesActive && !obsidian-artifacts.terminalHasMultiple",
          "group": "obsidian@1"
        },
        {
          "submenu": "obsidian-artifacts.submenu.terminal",
          "when": "obsidian-artifacts.vaultConfigured && obsidian-artifacts.terminalHasMultiple",
          "group": "obsidian@1"
        },
        {
          "command": "obsidian-artifacts.create.commands",
          "when": "obsidian-artifacts.vaultConfigured && obsidian-artifacts.commandsActive && !obsidian-artifacts.terminalCreateHasMultiple",
          "group": "3_create@1"
        },
        {
          "command": "obsidian-artifacts.create.aiprompts.terminal",
          "when": "obsidian-artifacts.vaultConfigured && obsidian-artifacts.aipromptsActive && !obsidian-artifacts.terminalCreateHasMultiple",
          "group": "3_create@2"
        },
        {
          "submenu": "obsidian-artifacts.submenu.create.terminal",
          "when": "obsidian-artifacts.vaultConfigured && obsidian-artifacts.terminalCreateHasMultiple",
          "group": "3_create@1"
        }
      ],
      "explorer/context": [
        {
          "command": "obsidian-artifacts.insert.templates",
          "when": "obsidian-artifacts.vaultConfigured && obsidian-artifacts.templatesActive && !obsidian-artifacts.explorerHasMultiple",
          "group": "obsidian@1"
        },
        {
          "command": "obsidian-artifacts.insert.aiagentsconf",
          "when": "obsidian-artifacts.vaultConfigured && obsidian-artifacts.aiagentsconfActive && !obsidian-artifacts.explorerHasMultiple",
          "group": "obsidian@1"
        },
        {
          "command": "obsidian-artifacts.insert.variables",
          "when": "obsidian-artifacts.vaultConfigured && obsidian-artifacts.variablesActive && !obsidian-artifacts.explorerHasMultiple",
          "group": "obsidian@1"
        },
        {
          "submenu": "obsidian-artifacts.submenu.explorer",
          "when": "obsidian-artifacts.vaultConfigured && obsidian-artifacts.explorerHasMultiple",
          "group": "obsidian@1"
        },
        {
          "command": "obsidian-artifacts.create.aiagentsconf",
          "when": "!listMultiSelection && obsidian-artifacts.vaultConfigured && obsidian-artifacts.aiagentsconfActive && !obsidian-artifacts.explorerCreateHasMultiple",
          "group": "3_create@1"
        },
        {
          "command": "obsidian-artifacts.create.aiagentsconf.index",
          "when": "listMultiSelection && obsidian-artifacts.vaultConfigured && obsidian-artifacts.aiagentsconfActive && !obsidian-artifacts.explorerCreateHasMultiple",
          "group": "3_create@1"
        },
        {
          "command": "obsidian-artifacts.create.templates",
          "when": "!listMultiSelection && obsidian-artifacts.vaultConfigured && obsidian-artifacts.templatesActive && !obsidian-artifacts.explorerCreateHasMultiple",
          "group": "3_create@2"
        },
        {
          "command": "obsidian-artifacts.create.templates.index",
          "when": "listMultiSelection && obsidian-artifacts.vaultConfigured && obsidian-artifacts.templatesActive && !obsidian-artifacts.explorerCreateHasMultiple",
          "group": "3_create@2"
        },
        {
          "submenu": "obsidian-artifacts.submenu.create.explorer",
          "when": "obsidian-artifacts.vaultConfigured && obsidian-artifacts.explorerCreateHasMultiple",
          "group": "3_create@1"
        }
      ],
      "obsidian-artifacts.submenu.editor": [
        {
          "command": "obsidian-artifacts.insert.snippets",
          "when": "obsidian-artifacts.snippetsActive",
          "group": "1_insert@1"
        },
        {
          "command": "obsidian-artifacts.insert.aiprompts",
          "when": "obsidian-artifacts.aipromptsActive",
          "group": "1_insert@2"
        },
        {
          "command": "obsidian-artifacts.insert.variables",
          "when": "obsidian-artifacts.variablesActive",
          "group": "2_variables@1"
        }
      ],
      "obsidian-artifacts.submenu.terminal": [
        {
          "command": "obsidian-artifacts.insert.commands",
          "when": "obsidian-artifacts.commandsActive",
          "group": "1_insert@1"
        },
        {
          "command": "obsidian-artifacts.insert.aiprompts.terminal",
          "when": "obsidian-artifacts.aipromptsActive",
          "group": "1_insert@2"
        },
        {
          "command": "obsidian-artifacts.insert.variables",
          "when": "obsidian-artifacts.variablesActive",
          "group": "2_variables@1"
        }
      ],
      "obsidian-artifacts.submenu.explorer": [
        {
          "command": "obsidian-artifacts.insert.templates",
          "when": "obsidian-artifacts.templatesActive",
          "group": "1_insert@1"
        },
        {
          "command": "obsidian-artifacts.insert.aiagentsconf",
          "when": "obsidian-artifacts.aiagentsconfActive",
          "group": "1_insert@2"
        },
        {
          "command": "obsidian-artifacts.insert.variables",
          "when": "obsidian-artifacts.variablesActive",
          "group": "2_variables@1"
        }
      ],
      "obsidian-artifacts.submenu.create.editor": [
        {
          "command": "obsidian-artifacts.create.snippets",
          "when": "obsidian-artifacts.snippetsActive",
          "group": "3_create@1"
        },
        {
          "command": "obsidian-artifacts.create.aiprompts",
          "when": "obsidian-artifacts.aipromptsActive",
          "group": "3_create@2"
        }
      ],
      "obsidian-artifacts.submenu.create.terminal": [
        {
          "command": "obsidian-artifacts.create.commands",
          "when": "obsidian-artifacts.commandsActive",
          "group": "3_create@1"
        },
        {
          "command": "obsidian-artifacts.create.aiprompts.terminal",
          "when": "obsidian-artifacts.aipromptsActive",
          "group": "3_create@2"
        }
      ],
      "obsidian-artifacts.submenu.create.explorer": [
        {
          "command": "obsidian-artifacts.create.aiagentsconf",
          "when": "!listMultiSelection && obsidian-artifacts.aiagentsconfActive",
          "group": "3_create@1"
        },
        {
          "command": "obsidian-artifacts.create.templates",
          "when": "!listMultiSelection && obsidian-artifacts.templatesActive",
          "group": "3_create@2"
        },
        {
          "command": "obsidian-artifacts.create.aiagentsconf.index",
          "when": "listMultiSelection && obsidian-artifacts.aiagentsconfActive",
          "group": "3_create@1"
        },
        {
          "command": "obsidian-artifacts.create.templates.index",
          "when": "listMultiSelection && obsidian-artifacts.templatesActive",
          "group": "3_create@2"
        }
      ],
      "view/title": [
        {
          "command": "obsidian-artifacts.variables.newFile",
          "when": "view == obsidian-artifacts.variablesView",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "obsidian-artifacts.variables.newSubSet",
          "when": "view == obsidian-artifacts.variablesView && viewItem == file",
          "group": "inline@1"
        },
        {
          "command": "obsidian-artifacts.variables.deleteFile",
          "when": "view == obsidian-artifacts.variablesView && viewItem == file",
          "group": "1_modify@2"
        },
        {
          "command": "obsidian-artifacts.variables.addVar",
          "when": "view == obsidian-artifacts.variablesView && viewItem == subset",
          "group": "inline@1"
        },
        {
          "command": "obsidian-artifacts.variables.renameSubSet",
          "when": "view == obsidian-artifacts.variablesView && viewItem == subset",
          "group": "1_modify@1"
        },
        {
          "command": "obsidian-artifacts.variables.deleteSubSet",
          "when": "view == obsidian-artifacts.variablesView && viewItem == subset",
          "group": "1_modify@2"
        },
        {
          "command": "obsidian-artifacts.variables.editValue",
          "when": "view == obsidian-artifacts.variablesView && viewItem == var",
          "group": "inline@1"
        },
        {
          "command": "obsidian-artifacts.variables.renameVar",
          "when": "view == obsidian-artifacts.variablesView && viewItem == var",
          "group": "1_modify@1"
        },
        {
          "command": "obsidian-artifacts.variables.deleteVar",
          "when": "view == obsidian-artifacts.variablesView && viewItem == var",
          "group": "1_modify@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "obsidian-artifacts",
          "title": "Obsidian Artifacts",
          "icon": "media/obsidian-artifacts.svg"
        }
      ]
    },
    "views": {
      "obsidian-artifacts": [
        {
          "id": "obsidian-artifacts.mainView",
          "name": "Artifacts",
          "type": "webview"
        },
        {
          "id": "obsidian-artifacts.variablesView",
          "name": "Variables"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "obsidian-artifacts.mainView",
        "when": "!obsidian-artifacts.vaultConfigured",
        "contents": "Choose your Obsidian vault to start creating and inserting artifacts.\n[Choose Vault Folder](command:obsidian-artifacts.settings)"
      },
      {
        "view": "obsidian-artifacts.variablesView",
        "when": "!obsidian-artifacts.vaultConfigured",
        "contents": "Variable sets live in your vault's Variables folder.\n[Choose Vault Folder](command:obsidian-artifacts.settings)"
      }
    ],
    "configuration": {
      "title": "Obsidian Artifacts: AI Snippets & Tools",
      "properties": {
        "obsidianArtifacts.vaultPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the Obsidian vault root directory. Must contain a .obsidian folder.",
          "scope": "machine-overridable"
        },
        "obsidianArtifacts.defaultEnvironment": {
          "type": "string",
          "default": "",
          "description": "Default environment identifier (reserved for future use).",
          "scope": "language-overridable"
        },
        "obsidianArtifacts.features.snippets": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Snippets directory. Auto-created on first vault selection."
        },
        "obsidianArtifacts.features.aiagentsconf": {
          "type": "boolean",
          "default": true,
          "description": "Enable the AI Agents Config directory. Auto-created on first vault selection."
        },
        "obsidianArtifacts.features.commands": {
          "type": "boolean",
          "default": false,
          "description": "Enable the Commands directory (terminal context menu)."
        },
        "obsidianArtifacts.features.templates": {
          "type": "boolean",
          "default": false,
          "description": "Enable the Templates directory (Explorer context menu — Insert Template)."
        },
        "obsidianArtifacts.features.aiprompts": {
          "type": "boolean",
          "default": true,
          "description": "Enable the AI Prompts directory. Auto-created on first vault selection."
        },
        "obsidianArtifacts.features.variables": {
          "type": "boolean",
          "default": false,
          "description": "Enable the Variables directory (appears in all context menus)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "25.6.0",
    "@types/vscode": "^1.116.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vscode/codicons": "0.0.46-24",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "eslint": "^10.2.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "highlight.js": "^11.11.1"
  }
}
